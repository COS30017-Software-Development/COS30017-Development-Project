<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/profile_drawer"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/white">

	<LinearLayout
		android:id="@+id/profile_content"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical">

		<include layout="@layout/component_home_toolbar" />

		<androidx.core.widget.NestedScrollView
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:background="@color/surface_soft"
			android:fillViewport="true">

			<LinearLayout
				android:id="@+id/profile_page"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center_horizontal"
				android:orientation="vertical"
				android:paddingHorizontal="24dp"
				android:paddingTop="32dp"
				android:paddingBottom="32dp">

				<com.google.android.material.imageview.ShapeableImageView
					android:id="@+id/profile_avatar"
					android:layout_width="224dp"
					android:layout_height="224dp"
					android:background="@drawable/bg_profile_avatar"
					android:contentDescription="@string/profile_default_avatar"
					android:padding="30dp"
					android:scaleType="centerCrop"
					android:src="@drawable/ic_profile"
					app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Campus.Circle"
					app:tint="@color/white" />

				<TextView
					android:id="@+id/profile_title"
					style="@style/Campus.SectionTitle"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:text="@string/profile_title"
					android:textSize="28sp" />

				<com.google.android.material.card.MaterialCardView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="24dp"
					app:cardCornerRadius="16dp"
					app:cardElevation="1dp"
					app:strokeColor="@color/outline_soft"
					app:strokeWidth="1dp">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						android:padding="24dp">

						<TextView style="@style/Campus.ProfileLabel" android:text="@string/profile_name_label" />
						<TextView android:id="@+id/profile_name" style="@style/Campus.ProfileValue" />
						<TextView style="@style/Campus.ProfileLabel" android:layout_marginTop="20dp" android:text="@string/profile_email_label" />
						<TextView android:id="@+id/profile_email" style="@style/Campus.ProfileValue" />
						<TextView style="@style/Campus.ProfileLabel" android:layout_marginTop="20dp" android:text="@string/profile_student_id_label" />
						<TextView android:id="@+id/profile_student_id" style="@style/Campus.ProfileValue" />
					</LinearLayout>
				</com.google.android.material.card.MaterialCardView>

				<com.google.android.material.button.MaterialButton
					android:id="@+id/profile_edit"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="20dp"
					android:minHeight="56dp"
					android:text="@string/profile_edit"
					android:textAllCaps="false"
					android:textColor="@color/white"
					app:backgroundTint="@color/brand_red_accessible"
					app:cornerRadius="12dp" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/profile_my_posts"
					style="@style/Widget.MaterialComponents.Button.OutlinedButton"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:minHeight="56dp"
					android:text="@string/my_posts"
					android:textAllCaps="false"
					android:textColor="@color/brand_red_accessible"
					app:cornerRadius="12dp"
					app:strokeColor="@color/brand_red_accessible" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/profile_my_claims"
					style="@style/Widget.MaterialComponents.Button.OutlinedButton"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:minHeight="56dp"
					android:text="@string/my_requests"
					android:textAllCaps="false"
					android:textColor="@color/brand_red_accessible"
					app:cornerRadius="12dp"
					app:strokeColor="@color/brand_red_accessible" />

				<com.google.android.material.button.MaterialButton
					android:id="@+id/profile_logout"
					style="@style/Widget.MaterialComponents.Button.OutlinedButton"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="12dp"
					android:minHeight="56dp"
					android:text="@string/profile_logout"
					android:textAllCaps="false"
					android:textColor="@color/brand_red_accessible"
					app:cornerRadius="12dp"
					app:strokeColor="@color/brand_red_accessible" />
			</LinearLayout>
		</androidx.core.widget.NestedScrollView>

		<View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline_soft" />
		<include layout="@layout/component_bottom_navigation" />
	</LinearLayout>

	<include layout="@layout/component_side_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>

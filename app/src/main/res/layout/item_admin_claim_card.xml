<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="12dp"
	app:cardBackgroundColor="@color/white"
	app:cardCornerRadius="16dp"
	app:cardElevation="0dp"
	app:strokeColor="@color/outline_soft"
	app:strokeWidth="1dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="16dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/admin_claim_item_title"
				style="@style/Campus.SectionTitle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:textSize="18sp" />

			<TextView
				android:id="@+id/admin_claim_status"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_badge"
				android:paddingHorizontal="10dp"
				android:paddingVertical="6dp"
				android:textSize="12sp" />
		</LinearLayout>

		<TextView
			android:id="@+id/admin_claim_applicant"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:textColor="@color/text_secondary" />

		<TextView
			android:id="@+id/admin_claim_description"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp" />

		<TextView
			android:id="@+id/admin_claim_date"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:textColor="@color/text_secondary"
			android:textSize="12sp" />

		<LinearLayout
			android:id="@+id/admin_claim_actions"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:orientation="horizontal">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/admin_claim_reject"
				style="@style/Widget.MaterialComponents.Button.OutlinedButton"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginEnd="6dp"
				android:layout_weight="1"
				android:text="@string/admin_claim_reject"
				android:textAllCaps="false"
				app:strokeColor="@color/brand_red_accessible" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/admin_claim_approve"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:layout_weight="1"
				android:text="@string/admin_claim_approve"
				android:textAllCaps="false"
				app:backgroundTint="@color/brand_red_accessible"
				app:cornerRadius="12dp" />
		</LinearLayout>
	</LinearLayout>
</com.google.android.material.card.MaterialCardView>

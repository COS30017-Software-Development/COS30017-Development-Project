<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginBottom="12dp"
	app:cardBackgroundColor="@color/white"
	app:cardCornerRadius="12dp"
	app:cardElevation="0dp"
	app:strokeColor="@color/admin_card_stroke"
	app:strokeWidth="1dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:padding="16dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/admin_claim_item_title"
				style="@style/Campus.SectionTitle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginEnd="8dp"
				android:layout_weight="1"
				android:textSize="18sp" />

			<TextView
				android:id="@+id/admin_claim_status"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="@drawable/bg_status_pill"
				android:fontFamily="sans-serif-medium"
				android:paddingHorizontal="10dp"
				android:paddingVertical="4dp"
				android:textSize="12sp" />
		</LinearLayout>

		<TextView
			android:id="@+id/admin_claim_applicant"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="10dp"
			android:lineSpacingExtra="2dp"
			android:textColor="@color/text_secondary"
			android:textSize="13sp" />

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginVertical="12dp"
			android:background="@color/admin_card_stroke" />

		<TextView
			android:id="@+id/admin_claim_description"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:lineSpacingExtra="3dp"
			android:textColor="@color/black"
			android:textSize="14sp" />

		<TextView
			android:id="@+id/admin_claim_date"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:textColor="@color/text_secondary"
			android:textSize="12sp" />

		<LinearLayout
			android:id="@+id/admin_claim_actions"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="14dp"
			android:orientation="horizontal">

			<com.google.android.material.button.MaterialButton
				android:id="@+id/admin_claim_reject"
				style="@style/Widget.MaterialComponents.Button.OutlinedButton"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginEnd="6dp"
				android:layout_weight="1"
				android:text="@string/admin_claim_reject"
				android:textAllCaps="false"
				android:textColor="@color/admin_red"
				app:backgroundTint="@color/white"
				app:cornerRadius="12dp"
				app:strokeColor="@color/admin_red"
				app:strokeWidth="1dp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/admin_claim_approve"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="6dp"
				android:layout_weight="1"
				android:text="@string/admin_claim_approve"
				android:textAllCaps="false"
				android:textColor="@color/white"
				app:backgroundTint="@color/admin_black"
				app:cornerRadius="12dp" />
		</LinearLayout>
	</LinearLayout>
</com.google.android.material.card.MaterialCardView>

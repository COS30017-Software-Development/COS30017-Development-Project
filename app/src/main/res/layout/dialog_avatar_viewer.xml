<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/avatar_viewer_overlay"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:contentDescription="@string/profile_avatar_viewer_close"
	android:focusable="true"
	android:clickable="true">

	<View
		android:id="@+id/avatar_viewer_scrim"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/avatar_viewer_scrim" />

	<ImageView
		android:id="@+id/avatar_viewer_image"
		android:layout_width="1dp"
		android:layout_height="1dp"
		android:adjustViewBounds="true"
		android:contentDescription="@string/profile_avatar_viewer_image"
		android:scaleType="fitCenter" />
</FrameLayout>

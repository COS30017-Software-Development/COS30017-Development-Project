<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/auth_page"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/white"
	android:orientation="vertical">

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="64dp">

		<ImageButton
			android:id="@+id/auth_back"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:layout_gravity="start|center_vertical"
			android:layout_marginStart="12dp"
			android:background="?attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/auth_back_home"
			android:src="@drawable/ic_back" />
	</FrameLayout>

	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:fillViewport="true">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="24dp"
			android:paddingTop="16dp"
			android:paddingEnd="24dp"
			android:paddingBottom="32dp">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:paddingBottom="8dp">

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:fontFamily="sans-serif-black"
					android:letterSpacing="0.08"
					android:text="@string/brand_name"
					android:textColor="@color/black"
					android:textSize="24sp" />

				<TextView
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:letterSpacing="0.16"
					android:text="@string/brand_subtitle"
					android:textColor="@color/black"
					android:textSize="11sp" />

				<View
					android:layout_width="36dp"
					android:layout_height="4dp"
					android:layout_marginTop="20dp"
					android:background="@color/brand_red" />

				<TextView
					android:id="@+id/auth_title"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_marginTop="16dp"
					android:fontFamily="sans-serif-black"
					android:text="@string/auth_login_title"
					android:textColor="@color/black"
					android:textSize="32sp" />
			</LinearLayout>

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/auth_name_layout"
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:hint="@string/auth_name"
				app:boxCornerRadiusBottomEnd="12dp"
				app:boxCornerRadiusBottomStart="12dp"
				app:boxCornerRadiusTopEnd="12dp"
				app:boxCornerRadiusTopStart="12dp"
				app:endIconMode="none">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/auth_name"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:autofillHints="personName"
					android:imeOptions="actionNext"
					android:inputType="textPersonName"
					android:minHeight="56dp"
					android:saveEnabled="false"
					android:singleLine="true" />
			</com.google.android.material.textfield.TextInputLayout>

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/auth_student_id_layout"
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:hint="@string/auth_student_id"
				app:boxCornerRadiusBottomEnd="12dp"
				app:boxCornerRadiusBottomStart="12dp"
				app:boxCornerRadiusTopEnd="12dp"
				app:boxCornerRadiusTopStart="12dp"
				app:endIconMode="none">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/auth_student_id"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:digits="0123456789"
					android:imeOptions="actionNext"
					android:importantForAutofill="no"
					android:inputType="number"
					android:minHeight="56dp"
					android:saveEnabled="false"
					android:singleLine="true" />
			</com.google.android.material.textfield.TextInputLayout>

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/auth_email_layout"
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:hint="@string/auth_email"
				app:boxCornerRadiusBottomEnd="12dp"
				app:boxCornerRadiusBottomStart="12dp"
				app:boxCornerRadiusTopEnd="12dp"
				app:boxCornerRadiusTopStart="12dp"
				app:endIconMode="none">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/auth_email"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:autofillHints="emailAddress"
					android:imeOptions="actionNext"
					android:inputType="textEmailAddress"
					android:minHeight="56dp"
					android:saveEnabled="false"
					android:singleLine="true" />
			</com.google.android.material.textfield.TextInputLayout>

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/auth_password_layout"
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:hint="@string/auth_password"
				app:boxCornerRadiusBottomEnd="12dp"
				app:boxCornerRadiusBottomStart="12dp"
				app:boxCornerRadiusTopEnd="12dp"
				app:boxCornerRadiusTopStart="12dp"
				app:endIconMode="password_toggle">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/auth_password"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:imeOptions="actionNext"
					android:importantForAutofill="no"
					android:inputType="textPassword"
					android:minHeight="56dp"
					android:saveEnabled="false"
					android:singleLine="true" />
			</com.google.android.material.textfield.TextInputLayout>

			<LinearLayout
				android:id="@+id/auth_password_requirements"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:orientation="vertical"
				android:visibility="gone">

				<TextView
					android:id="@+id/password_requirement_length"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="4dp"
					android:text="@string/password_requirement_length"
					android:textColor="@color/text_secondary"
					android:textSize="12sp" />

				<TextView
					android:id="@+id/password_requirement_digit"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="4dp"
					android:text="@string/password_requirement_digit"
					android:textColor="@color/text_secondary"
					android:textSize="12sp" />

				<TextView
					android:id="@+id/password_requirement_special"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="4dp"
					android:text="@string/password_requirement_special"
					android:textColor="@color/text_secondary"
					android:textSize="12sp" />

				<TextView
					android:id="@+id/password_requirement_uppercase"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="4dp"
					android:text="@string/password_requirement_uppercase"
					android:textColor="@color/text_secondary"
					android:textSize="12sp" />

				<TextView
					android:id="@+id/password_requirement_lowercase"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingTop="4dp"
					android:text="@string/password_requirement_lowercase"
					android:textColor="@color/text_secondary"
					android:textSize="12sp" />
			</LinearLayout>

			<com.google.android.material.textfield.TextInputLayout
				android:id="@+id/auth_confirm_password_layout"
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:hint="@string/auth_confirm_password"
				app:boxCornerRadiusBottomEnd="12dp"
				app:boxCornerRadiusBottomStart="12dp"
				app:boxCornerRadiusTopEnd="12dp"
				app:boxCornerRadiusTopStart="12dp"
				app:endIconMode="password_toggle">

				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/auth_confirm_password"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:imeOptions="actionDone"
					android:importantForAutofill="no"
					android:inputType="textPassword"
					android:minHeight="56dp"
					android:saveEnabled="false"
					android:singleLine="true" />
			</com.google.android.material.textfield.TextInputLayout>

			<com.google.android.material.button.MaterialButton
				android:id="@+id/auth_submit"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="24dp"
				android:enabled="false"
				android:minHeight="56dp"
				android:text="@string/auth_login"
				android:textAllCaps="false"
				android:textSize="16sp"
				app:cornerRadius="12dp" />

			<com.google.android.material.button.MaterialButton
				android:id="@+id/auth_switch"
				style="@style/Widget.MaterialComponents.Button.TextButton"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="end"
				android:minHeight="48dp"
				android:text="@string/auth_sign_up"
				android:textAllCaps="false"
				android:textColor="@color/brand_red_accessible" />
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>
</LinearLayout>

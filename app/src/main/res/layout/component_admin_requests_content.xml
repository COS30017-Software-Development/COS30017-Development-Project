<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">

	<HorizontalScrollView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:clipToPadding="false"
		android:paddingHorizontal="16dp"
		android:paddingTop="14dp"
		android:paddingBottom="6dp"
		android:scrollbars="none">

		<com.google.android.material.chip.ChipGroup
			android:id="@+id/admin_claim_filter_group"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			app:chipSpacingHorizontal="8dp"
			app:selectionRequired="true"
			app:singleLine="true"
			app:singleSelection="true">

			<com.google.android.material.chip.Chip
				android:id="@+id/admin_claim_filter_all"
				style="@style/Widget.Material3.Chip.Filter"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:checked="true"
				android:text="@string/filter_all"
				android:textColor="@color/admin_chip_text"
				app:checkedIconVisible="false"
				app:chipBackgroundColor="@color/admin_chip_background"
				app:chipCornerRadius="20dp"
				app:chipMinHeight="36dp"
				app:chipStrokeWidth="0dp" />

			<com.google.android.material.chip.Chip
				android:id="@+id/admin_claim_filter_pending"
				style="@style/Widget.Material3.Chip.Filter"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/claim_status_pending"
				android:textColor="@color/admin_chip_text"
				app:checkedIconVisible="false"
				app:chipBackgroundColor="@color/admin_chip_background"
				app:chipCornerRadius="20dp"
				app:chipMinHeight="36dp"
				app:chipStrokeWidth="0dp" />

			<com.google.android.material.chip.Chip
				android:id="@+id/admin_claim_filter_approved"
				style="@style/Widget.Material3.Chip.Filter"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/admin_filter_approved"
				android:textColor="@color/admin_chip_text"
				app:checkedIconVisible="false"
				app:chipBackgroundColor="@color/admin_chip_background"
				app:chipCornerRadius="20dp"
				app:chipMinHeight="36dp"
				app:chipStrokeWidth="0dp" />

			<com.google.android.material.chip.Chip
				android:id="@+id/admin_claim_filter_rejected"
				style="@style/Widget.Material3.Chip.Filter"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/claim_status_rejected"
				android:textColor="@color/admin_chip_text"
				app:checkedIconVisible="false"
				app:chipBackgroundColor="@color/admin_chip_background"
				app:chipCornerRadius="20dp"
				app:chipMinHeight="36dp"
				app:chipStrokeWidth="0dp" />
		</com.google.android.material.chip.ChipGroup>
	</HorizontalScrollView>

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/admin_requests_list"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:padding="14dp" />

		<TextView
			android:id="@+id/admin_requests_empty"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="center"
			android:gravity="center"
			android:padding="24dp"
			android:text="@string/admin_claim_empty"
			android:textColor="@color/text_secondary"
			android:visibility="gone" />
	</FrameLayout>
</LinearLayout>

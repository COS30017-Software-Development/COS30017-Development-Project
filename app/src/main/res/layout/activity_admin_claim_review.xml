<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/admin_claim_review_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/surface_soft"
	android:orientation="vertical">

	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/admin_claim_review_toolbar"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/white"
		android:minHeight="56dp"
		app:navigationIcon="@drawable/ic_back"
		app:navigationContentDescription="@string/back_to_items"
		app:title="@string/admin_claim_review_title"
		app:titleTextColor="@color/black" />

	<FrameLayout
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/admin_claim_review_list"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:padding="14dp" />

		<TextView
			android:id="@+id/admin_claim_review_empty"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_gravity="center"
			android:gravity="center"
			android:padding="24dp"
			android:text="@string/admin_claim_empty"
			android:textColor="@color/text_secondary"
			android:visibility="gone" />
	</FrameLayout>
</LinearLayout>

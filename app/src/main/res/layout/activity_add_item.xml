<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/add_item_root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/surface_soft"
	android:orientation="vertical">

	<com.google.android.material.appbar.MaterialToolbar
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/white"
		android:minHeight="56dp"
		app:title="@string/add_item_title"
		app:titleTextColor="@color/black" />

	<androidx.core.widget.NestedScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="20dp">

			<TextView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:text="@string/item_type_label"
				android:textColor="@color/text_secondary"
				android:textSize="13sp" />

			<RadioGroup
				android:id="@+id/add_item_type"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:orientation="horizontal">

				<RadioButton
					android:id="@+id/add_item_type_lost"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:checked="true"
					android:text="@string/lost" />

				<RadioButton
					android:id="@+id/add_item_type_found"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/found" />
			</RadioGroup>

			<com.google.android.material.textfield.TextInputLayout
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:hint="@string/item_name">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/add_item_name"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:inputType="textCapSentences"
					android:singleLine="true" />
			</com.google.android.material.textfield.TextInputLayout>

			<com.google.android.material.textfield.TextInputLayout
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:hint="@string/item_category">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/add_item_category"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:inputType="textCapWords"
					android:singleLine="true" />
			</com.google.android.material.textfield.TextInputLayout>

			<com.google.android.material.textfield.TextInputLayout
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:hint="@string/item_location">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/add_item_location"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:inputType="textCapWords"
					android:singleLine="true" />
			</com.google.android.material.textfield.TextInputLayout>

			<com.google.android.material.textfield.TextInputLayout
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:hint="@string/item_description">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/add_item_description"
					android:layout_width="match_parent"
					android:layout_height="120dp"
					android:gravity="top"
					android:inputType="textCapSentences|textMultiLine" />
			</com.google.android.material.textfield.TextInputLayout>

			<com.google.android.material.textfield.TextInputLayout
				style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="16dp"
				android:hint="@string/item_image_name">
				<com.google.android.material.textfield.TextInputEditText
					android:id="@+id/add_item_image_name"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:inputType="text"
					android:singleLine="true" />
			</com.google.android.material.textfield.TextInputLayout>
		</LinearLayout>
	</androidx.core.widget.NestedScrollView>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@color/white"
		android:orientation="vertical"
		android:padding="16dp">
		<com.google.android.material.button.MaterialButton
			android:id="@+id/add_item_save"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="52dp"
			android:text="@string/post_item"
			android:textAllCaps="false"
			android:textColor="@color/white"
			app:backgroundTint="@color/brand_red_accessible"
			app:cornerRadius="12dp" />
		<com.google.android.material.button.MaterialButton
			android:id="@+id/add_item_cancel"
			style="@style/Widget.MaterialComponents.Button.TextButton"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="@string/cancel"
			android:textAllCaps="false"
			android:textColor="@color/black" />
	</LinearLayout>
</LinearLayout>

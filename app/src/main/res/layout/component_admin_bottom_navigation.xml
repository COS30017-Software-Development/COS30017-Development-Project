<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.bottomnavigation.BottomNavigationView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/admin_bottom_navigation"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@color/white"
	android:elevation="0dp"
	android:minHeight="72dp"
	app:itemBackground="@drawable/bg_navigation_item"
	app:itemHorizontalTranslationEnabled="false"
	app:itemIconTint="@color/admin_navigation_colors"
	app:itemTextAppearanceActive="@style/Campus.NavigationLabel"
	app:itemTextAppearanceInactive="@style/Campus.NavigationLabel"
	app:itemTextColor="@color/admin_navigation_colors"
	app:labelVisibilityMode="labeled"
	app:menu="@menu/admin_bottom_navigation" />

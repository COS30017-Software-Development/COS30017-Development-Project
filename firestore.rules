rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && resource.data.postedBy == request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'ADMIN';
    }

    function validItem(data) {
      return data.keys().hasAll([
          'itemId', 'itemName', 'description', 'category', 'location',
          'date', 'type', 'imageUrl', 'imageName', 'status', 'postedBy'
        ])
        && data.keys().hasOnly([
          'itemId', 'itemName', 'description', 'category', 'location',
          'date', 'type', 'imageUrl', 'imageName', 'status', 'postedBy'
        ])
        && data.itemId is string
        && data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 100
        && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.location is string && data.location.size() > 0 && data.location.size() <= 100
        && data.date is timestamp
        && data.type in ['LOST', 'FOUND']
        && (data.imageUrl == null || data.imageUrl is string)
        && data.imageName is string && data.imageName.size() > 0 && data.imageName.size() <= 100
        && data.status in ['OPEN', 'CLAIMED', 'CLOSED']
        && data.postedBy is string;
    }

    match /items/{itemId} {
      allow read: if true;
      allow create: if signedIn()
        && validItem(request.resource.data)
        && request.resource.data.itemId == itemId
        && request.resource.data.postedBy == request.auth.uid
        && request.resource.data.status == 'OPEN';
      allow update: if isOwner()
        && validItem(request.resource.data)
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.postedBy == resource.data.postedBy
        && request.resource.data.date == resource.data.date
        && request.resource.data.type == resource.data.type
        && request.resource.data.imageUrl == resource.data.imageUrl
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['itemName', 'description', 'category', 'location', 'imageName']);
      allow delete: if isOwner() || isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('role', '') == 'ADMIN';
    }

    function itemPath(itemId) {
      return /databases/$(database)/documents/items/$(itemId);
    }

    function claimPath(claimId) {
      return /databases/$(database)/documents/claims/$(claimId);
    }

    function notificationPath(notificationId) {
      return /databases/$(database)/documents/notifications/$(notificationId);
    }

    function validItem(data) {
      return data.keys().hasAll([
          'itemId', 'itemName', 'description', 'category', 'location',
          'date', 'type', 'imageUrl', 'imageName', 'status', 'postedBy'
        ])
        && data.keys().hasOnly([
          'itemId', 'itemName', 'description', 'category', 'location',
          'date', 'type', 'imageUrl', 'imageName', 'status', 'postedBy',
          'pendingClaimCount', 'lastReviewedClaimId', 'lastAcceptedRequestId'
        ])
        && data.itemId is string
        && data.itemName is string && data.itemName.size() > 0 && data.itemName.size() <= 100
        && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.location is string && data.location.size() > 0 && data.location.size() <= 100
        && data.date is timestamp
        && data.type in ['LOST', 'FOUND']
        && (data.imageUrl == null || data.imageUrl is string)
        && data.imageName is string && data.imageName.size() > 0 && data.imageName.size() <= 100
        && data.status in ['OPEN', 'CLAIMED', 'PENDING_RETURN', 'CLOSED']
        && (!data.keys().hasAny(['pendingClaimCount'])
          || (data.pendingClaimCount is int && data.pendingClaimCount >= 0))
        && (!data.keys().hasAny(['lastReviewedClaimId'])
          || data.lastReviewedClaimId is string)
        && (!data.keys().hasAny(['lastAcceptedRequestId'])
          || data.lastAcceptedRequestId is string)
        && data.postedBy is string;
    }

    function validClaim(data, claimId) {
      return data.keys().hasAll([
          'claimId', 'itemId', 'itemType', 'studentId', 'ownerUid', 'description',
          'status', 'submittedAt', 'itemTitle', 'itemLocation',
          'studentName', 'studentEmail', 'studentNumber', 'notificationId'
        ])
        && data.keys().hasOnly([
          'claimId', 'itemId', 'itemType', 'studentId', 'ownerUid', 'description',
          'status', 'submittedAt', 'itemTitle', 'itemLocation',
          'studentName', 'studentEmail', 'studentNumber', 'notificationId'
        ])
        && data.claimId == claimId
        && data.claimId == data.studentId + '_' + data.itemId
        && data.itemId is string
        && data.itemType in ['FOUND', 'LOST']
        && data.studentId is string
        && data.ownerUid is string
        && data.description is string
        && data.description.size() >= 10 && data.description.size() <= 500
        && data.status in ['Pending', 'Accepted', 'Rejected', 'PENDING', 'APPROVED', 'REJECTED']
        && data.submittedAt is timestamp
        && data.itemTitle is string && data.itemTitle.size() > 0 && data.itemTitle.size() <= 100
        && data.itemLocation is string && data.itemLocation.size() > 0 && data.itemLocation.size() <= 100
        && data.studentName is string && data.studentName.size() <= 100
        && data.studentEmail is string && data.studentEmail.size() <= 254
        && data.studentNumber is string && data.studentNumber.size() <= 50
        && data.notificationId is string;
    }

    function validNewRequestNotificationLink(data, claimId) {
      let note = getAfter(notificationPath(data.notificationId)).data;
      return existsAfter(notificationPath(data.notificationId))
        && note.relatedRequestId == claimId
        && note.senderUid == request.auth.uid
        && note.type == (data.itemType == 'FOUND' ? 'CLAIM_REQUEST' : 'FOUND_REQUEST');
    }

    function validRequestNotification(data, notificationId, item) {
      let requestPath = claimPath(data.relatedRequestId);
      let requestAfter = getAfter(requestPath).data;
      let requestBefore = get(requestPath).data;
      let expectedType = item.type == 'FOUND' ? 'CLAIM_REQUEST' : 'FOUND_REQUEST';
      return data.type == expectedType
        && data.itemType == item.type
        && data.itemTitle == item.itemName
        && data.itemLocation == item.location
        && data.relatedItemId == null
        && data.relatedItemType == null
        && data.relatedItemTitle == null
        && data.relatedItemLocation == null
        && data.recipientUid == item.postedBy
        && data.senderUid != item.postedBy
        && data.title == (expectedType == 'CLAIM_REQUEST' ? 'New claim request' : 'New found request')
        && data.message
          == (data.senderName.size() > 0 ? data.senderName : 'A student')
            + ' sent a request for "' + item.itemName + '".'
        && existsAfter(requestPath)
        && requestAfter.claimId == data.relatedRequestId
        && requestAfter.notificationId == notificationId
        && requestAfter.studentId == data.senderUid
        && requestAfter.ownerUid == item.postedBy
        && requestAfter.itemType == item.type
        && requestAfter.studentName == data.senderName
        && requestAfter.itemId == data.itemId
        && requestAfter.itemTitle == data.itemTitle
        && requestAfter.itemLocation == data.itemLocation
        && requestAfter.status == 'Pending'
        && requestAfter.submittedAt == data.createdAt
        && (!exists(requestPath) || requestBefore.status == 'Rejected' || requestBefore.status == 'REJECTED');
    }

    function validAcceptanceNotification(data, notificationId, item) {
      let requestPath = claimPath(data.relatedRequestId);
      let requestAfter = getAfter(requestPath).data;
      return data.type == 'REQUEST_ACCEPTED'
        && data.itemType == item.type
        && data.itemTitle == item.itemName
        && data.itemLocation == item.location
        && data.relatedItemId == null
        && data.relatedItemType == null
        && data.relatedItemTitle == null
        && data.relatedItemLocation == null
        && data.senderUid == item.postedBy
        && data.recipientUid == requestAfter.studentId
        && data.title == 'Request accepted'
        && data.message == 'Your request for "' + item.itemName + '" was accepted.'
        && existsAfter(requestPath)
        && requestAfter.status == 'Accepted'
        && requestAfter.itemId == data.itemId
        && requestAfter.ownerUid == item.postedBy
        && requestAfter.itemType == item.type;
    }

    function validNotification(data, notificationId) {
      return signedIn()
        && data.keys().hasAll([
          'recipientUid', 'senderUid', 'senderName', 'type', 'relatedRequestId',
          'itemId', 'itemType', 'itemTitle', 'itemLocation',
          'relatedItemId', 'relatedItemType', 'relatedItemTitle', 'relatedItemLocation',
          'title', 'message', 'createdAt', 'isRead'
        ])
        && data.keys().hasOnly([
          'recipientUid', 'senderUid', 'senderName', 'type', 'relatedRequestId',
          'itemId', 'itemType', 'itemTitle', 'itemLocation',
          'relatedItemId', 'relatedItemType', 'relatedItemTitle', 'relatedItemLocation',
          'title', 'message', 'createdAt', 'isRead'
        ])
        && data.recipientUid is string
        && data.senderUid == request.auth.uid
        && data.senderName is string && data.senderName.size() <= 100
        && data.type in ['CLAIM_REQUEST', 'FOUND_REQUEST', 'REQUEST_ACCEPTED']
        && data.relatedRequestId is string
        && data.itemId is string
        && data.itemType in ['FOUND', 'LOST']
        && data.itemTitle is string && data.itemTitle.size() > 0 && data.itemTitle.size() <= 100
        && data.itemLocation is string && data.itemLocation.size() > 0 && data.itemLocation.size() <= 100
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.message is string && data.message.size() > 0 && data.message.size() <= 250
        && data.createdAt is timestamp
        && data.isRead == false
        && exists(itemPath(data.itemId))
        && (
          ((data.type == 'CLAIM_REQUEST' || data.type == 'FOUND_REQUEST')
            && validRequestNotification(data, notificationId, get(itemPath(data.itemId)).data))
          || (data.type == 'REQUEST_ACCEPTED'
            && validAcceptanceNotification(data, notificationId, get(itemPath(data.itemId)).data))
        );
    }

    function validRequestItemUpdate(itemId) {
      let requestId = request.resource.data.get('lastAcceptedRequestId', '');
      let requestPath = claimPath(requestId);
      let requestBefore = get(requestPath).data;
      let requestAfter = getAfter(requestPath).data;
      return signedIn()
        && (resource.data.postedBy == request.auth.uid || isAdmin())
        && requestId is string
        && exists(requestPath)
        && existsAfter(requestPath)
        && requestBefore.itemId == itemId
        && requestBefore.status in ['Pending', 'PENDING']
        && requestAfter.status == 'Accepted'
        && requestAfter.ownerUid == resource.data.postedBy
        && requestAfter.itemId == itemId
        && request.resource.data.status == 'PENDING_RETURN'
        && resource.data.status in ['OPEN', 'CLAIMED', 'PENDING_RETURN']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'lastAcceptedRequestId'])
        && request.resource.data.postedBy == resource.data.postedBy
        && request.resource.data.itemId == resource.data.itemId;
    }

    match /items/{itemId} {
      allow read: if true;
      allow create: if signedIn()
        && validItem(request.resource.data)
        && request.resource.data.itemId == itemId
        && request.resource.data.postedBy == request.auth.uid
        && request.resource.data.pendingClaimCount == 0
        && request.resource.data.status == 'OPEN';
      allow update: if (
        signedIn()
        && resource.data.postedBy == request.auth.uid
        && validItem(request.resource.data)
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.postedBy == resource.data.postedBy
        && request.resource.data.date == resource.data.date
        && request.resource.data.type == resource.data.type
        && request.resource.data.imageUrl == resource.data.imageUrl
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['itemName', 'description', 'category', 'location', 'imageName'])
      ) || validRequestItemUpdate(itemId);
      allow delete: if signedIn()
        && (resource.data.postedBy == request.auth.uid || isAdmin())
        && resource.data.get('pendingClaimCount', 0) == 0;
    }

    match /claims/{claimId} {
      allow get: if signedIn()
        && (isAdmin()
          || (!exists(claimPath(claimId))
            && claimId.matches('^' + request.auth.uid + '_[A-Za-z0-9]+$'))
          || resource.data.studentId == request.auth.uid
          || resource.data.ownerUid == request.auth.uid);
      allow list: if signedIn()
        && (isAdmin()
          || resource.data.studentId == request.auth.uid
          || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && validClaim(request.resource.data, claimId)
        && validNewRequestNotificationLink(request.resource.data, claimId)
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'Pending'
        && request.resource.data.ownerUid != request.auth.uid
        && exists(itemPath(request.resource.data.itemId))
        && get(itemPath(request.resource.data.itemId)).data.type == request.resource.data.itemType
        && get(itemPath(request.resource.data.itemId)).data.postedBy == request.resource.data.ownerUid
        && get(itemPath(request.resource.data.itemId)).data.status != 'CLOSED'
        && get(itemPath(request.resource.data.itemId)).data.itemName == request.resource.data.itemTitle
        && get(itemPath(request.resource.data.itemId)).data.location == request.resource.data.itemLocation
        && (!exists(claimPath(claimId))
          || get(claimPath(claimId)).data.status in ['Rejected', 'REJECTED']);
      allow update: if (
        signedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin())
        && resource.data.status in ['Pending', 'PENDING']
        && request.resource.data.status == 'Accepted'
        && validClaim(request.resource.data, claimId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'ownerUid'])
        && exists(itemPath(resource.data.itemId))
        && getAfter(itemPath(resource.data.itemId)).data.lastAcceptedRequestId == claimId
      ) || (
        isAdmin()
        && resource.data.status in ['Pending', 'PENDING']
        && request.resource.data.status == 'Rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      ) || (
        signedIn()
        && resource.data.studentId == request.auth.uid
        && resource.data.status in ['Rejected', 'REJECTED']
        && request.resource.data.status == 'Pending'
        && validClaim(request.resource.data, claimId)
        && validNewRequestNotificationLink(request.resource.data, claimId)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.claimId == resource.data.claimId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description', 'status', 'submittedAt', 'itemTitle', 'itemLocation',
          'studentName', 'studentEmail', 'studentNumber', 'notificationId', 'ownerUid', 'itemType'
        ])
        && exists(itemPath(resource.data.itemId))
        && get(itemPath(resource.data.itemId)).data.postedBy == request.resource.data.ownerUid
        && get(itemPath(resource.data.itemId)).data.type == request.resource.data.itemType
        && get(itemPath(resource.data.itemId)).data.status != 'CLOSED'
      );
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if validNotification(request.resource.data, notificationId);
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && resource.data.isRead == false
        && request.resource.data.isRead == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    match /users/{uid}/fcmTokens/{tokenId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.updatedAt is timestamp;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function item(itemId) {
      return firestore.get(/databases/(default)/documents/items/$(itemId)).data;
    }

    function isOwner(itemId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/items/$(itemId))
        && item(itemId).postedBy == request.auth.uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('role', '') == 'ADMIN';
    }

    match /items/{itemId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner(itemId)
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.metadata.itemId == itemId;
      allow delete: if signedIn()
        && (resource.metadata.ownerUid == request.auth.uid || isAdmin())
        && resource.metadata.itemId == itemId;
    }
  }
}
